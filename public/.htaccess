# Origin lock: only Cloudflare may reach this host directly.
#
# The site is served through Cloudflare, but the origin IP is public:
# the MX record points at www329.your-server.de, which resolves to the
# same machine. Without this allowlist the proxy can simply be skipped.
#
# IP ranges from https://www.cloudflare.com/ips-v4 and /ips-v6.
# Cloudflare adds ranges occasionally - re-check when edge requests
# start returning 403.
#
# Since about 2026-09-30 Hetzner rewrites the client address of requests
# coming through Cloudflare to the visitor's IP (from CF-Connecting-IP), so
# "Require ip" no longer sees Cloudflare and would reject every visitor.
# CONN_REMOTE_ADDR is the address of the TCP connection itself, which is
# still Cloudflare's. Hence "Require expr ... -ipmatch" instead of "Require ip".

# Guarded on mod_authz_host, as before: without the module the lock degrades
# to a no-op instead of answering 500.
<IfModule mod_authz_host.c>
  <RequireAny>
    # Keep ACME reachable, otherwise Hetzner's Let's Encrypt renewal
    # fails and Cloudflare's Full (strict) mode breaks with it.
    Require expr "%{REQUEST_URI} =~ m#^/\.well-known/#"

    # Cloudflare IPv4
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '173.245.48.0/20'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '103.21.244.0/22'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '103.22.200.0/22'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '103.31.4.0/22'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '141.101.64.0/18'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '108.162.192.0/18'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '190.93.240.0/20'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '188.114.96.0/20'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '197.234.240.0/22'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '198.41.128.0/17'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '162.158.0.0/15'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '104.16.0.0/13'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '104.24.0.0/14'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '172.64.0.0/13'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '131.0.72.0/22'"

    # Cloudflare IPv6
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2400:cb00::/32'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2606:4700::/32'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2803:f800::/32'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2405:b500::/32'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2405:8100::/32'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2a06:98c0::/29'"
    Require expr "%{CONN_REMOTE_ADDR} -ipmatch '2c0f:f248::/32'"
  </RequireAny>
</IfModule>

# The FTP deploy keeps its sync state next to the files. It lists every
# uploaded file with a hash; nobody needs to download it.
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>
